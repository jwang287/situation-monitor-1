# Finnhub API Key
# Get your free key at: https://finnhub.io/
# Free tier: 60 calls/minute
VITE_FINNHUB_API_KEY=your_api_key_here

# FRED API Key (美联储经济数据)
# Get your free key at: https://fred.stlouisfed.org/docs/api/api_key.html
VITE_FRED_API_KEY=your_fred_api_key_here

# 微软翻译API Key (Azure Cognitive Services)
# 获取方式: https://azure.microsoft.com/services/cognitive-services/translator/
# 免费额度: 每月200万字符
VITE_MICROSOFT_TRANSLATOR_KEY=your_microsoft_translator_key_here

# 谷歌翻译API Key
# 获取方式: https://cloud.google.com/translate
# 需要Google Cloud账号，免费额度有限
VITE_GOOGLE_TRANSLATE_KEY=your_google_translate_key_here
